# Copy to .env (optional). All variables are optional; defaults work locally. Prefix: NEXFLOW_
# NEXFLOW_SUMO_BINARY=C:\Program Files (x86)\Eclipse\Sumo\bin\sumo.exe   # only if SUMO is not on PATH / SUMO_HOME
# NEXFLOW_MAX_CONCURRENT_SUMO=2
# NEXFLOW_MAP_ORIGIN_LAT=12.9716
# NEXFLOW_MAP_ORIGIN_LON=77.5946
# NEXFLOW_MEMORY_SIMILARITY_THRESHOLD=0.90
# NEXFLOW_MEMORY_DEMAND_TOLERANCE=0.25
# NEXFLOW_MEMORY_MIN_IMPROVEMENT=0.02
# NEXFLOW_SUMO_GUI=false
# NEXFLOW_LOG_JSON=false
